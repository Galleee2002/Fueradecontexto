# Copia a .env.local y rellena valores reales. En Vercel: Project → Settings → Environment Variables.
# No commitees secretos.

# --- Base de datos (Neon) ---
DATABASE_URL=

# --- Sitio público (sin barra final; afecta Mercado Pago: URLs de retorno y webhook) ---
NEXT_PUBLIC_SITE_URL=https://www.fueradecontexto.com.ar

# --- NextAuth (v5: AUTH_SECRET; en algunos despliegues también AUTH_URL) ---
AUTH_SECRET=
AUTH_URL=

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
# Obligatorio en producción: firma de notificaciones webhook (ver docs/MERCADOPAGO_WEBHOOK_SECRET_PENDING.md)
MERCADOPAGO_WEBHOOK_SECRET=

# --- Correo electrónico (Brevo) ---
BREVO_API_KEY=
# Remitente verificado en Brevo, ej: "Fueradecontexto <no-reply@tudominio.com>"
EMAIL_FROM=
EMAIL_ADMIN=

# --- Correo Argentino / MiCorreo (cotización e importación; remitente también en /admin/envios) ---
CORREO_ARGENTINO_BASE_URL=
CORREO_ARGENTINO_USERNAME=
CORREO_ARGENTINO_PASSWORD=
# Establecer a "false" para desactivar integración (solo si aplica en tu entorno)
# SHIPPING_CORREO_ARGENTINO_ENABLED=true

# --- Cloudinary (subida desde admin) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDER=

# --- Redes y contacto (WhatsApp: solo dígitos, ej. 5491161965319; en Vercel actualizá si cambió el número) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=5491161965319
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- SEO (opcional) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Smoke HTTP (solo script scripts/smoke-prod-http.ts; por defecto usa producción) ---
# SMOKE_BASE_URL=https://www.fueradecontexto.com.ar
