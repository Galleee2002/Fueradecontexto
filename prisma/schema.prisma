// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String   @id @default(cuid())
  name          String   @unique
  subcategories Json     @default("[]")
  createdAt     DateTime @default(now())
}

model StampLocation {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  hex       String
  createdAt DateTime @default(now())
}

model Product {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  description      String?
  price            Decimal     @db.Decimal(10, 2)
  imageUrl         String
  previewImages    Json        @default("[]")
  category         String
  subcategory      String      @default("")
  active           Boolean     @default(true)
  stock            Int         @default(0)
  availableColors  Json        @default("[]")
  availableSizes   Json        @default("[]")
  stampSizes       Json        @default("[]")
  stampLocations   Json        @default("[]")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cartItems        CartItem[]
  orderItems       OrderItem[]
}

model SizeGuide {
  id        String   @id @default(cuid())
  category  String   @unique
  rows      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  productId String
  quantity  Int     @default(1)
  sessionId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([productId, sessionId])
}

model Order {
  id              String      @id @default(cuid())
  customerEmail   String
  customerName    String
  customerPhone   String
  userId          String?
  total           Decimal     @db.Decimal(10, 2)
  status          String      @default("pending")
  shippingAddress Json
  mpPreferenceId  String?
  mpPaymentId     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}
